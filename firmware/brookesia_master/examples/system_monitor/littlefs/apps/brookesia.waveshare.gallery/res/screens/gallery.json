{
    "type": "viewScreen",
    "id": "gallery",
    "commonProps": {
        "clickable": true,
        "scrollable": false
    },
    "style": {
        "bgColor": "#05070c"
    },
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "clickable": false,
                "scrollable": false
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "mainAlign": "start",
                "crossAlign": "stretch",
                "gap": "${constant.gallery.layout.gap}"
            },
            "style": {
                "padding": "0dp"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.gallery.layout.pageX}",
                "y": "${constant.gallery.layout.pageY}",
                "width": "${constant.gallery.layout.pageWidth}",
                "height": "${constant.gallery.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "preview",
                    "commonProps": {
                        "clickable": false,
                        "scrollable": false
                    },
                    "style": {
                        "bgColor": "#0b0f16",
                        "borderWidth": "1dp",
                        "borderColor": "#1b2230",
                        "radius": "${constant.gallery.layout.cardRadius}",
                        "padding": "0dp",
                        "clipCorner": true
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "flexGrow": 1
                    },
                    "children": [
                        {
                            "type": "image",
                            "id": "photo",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "imageProps.src": "photo_src"
                            },
                            "imageProps": {
                                "src": "",
                                "innerAlign": "contain"
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": 0,
                                "y": 0,
                                "width": "match",
                                "height": "match"
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "id": "bar",
                    "commonProps": {
                        "clickable": false
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "mainAlign": "spaceBetween",
                        "crossAlign": "stretch",
                        "gap": "${constant.gallery.layout.barGap}"
                    },
                    "style": {
                        "bgColor": "#0d1626",
                        "radius": "16dp",
                        "borderWidth": "1dp",
                        "borderColor": "#1b2740",
                        "padding": "${constant.gallery.layout.barPadding}"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "${constant.gallery.layout.barHeight}"
                    },
                    "children": [
                        {
                            "type": "container",
                            "id": "info",
                            "commonProps": {
                                "clickable": false
                            },
                            "layout": {
                                "type": "flex",
                                "flexFlow": "row",
                                "mainAlign": "start",
                                "crossAlign": "center",
                                "gap": "12dp"
                            },
                            "style": {
                                "padding": "0dp"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "${constant.gallery.layout.infoHeight}"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "photo_index",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "bindings": {
                                        "labelProps.text": "photo_index"
                                    },
                                    "labelProps": {
                                        "text": "0 / 0"
                                    },
                                    "style": {
                                        "textColor": "#7f8ea3",
                                        "fontSize": "${constant.gallery.font.meta}"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "90dp",
                                        "height": "wrap"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "file_name",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "bindings": {
                                        "labelProps.text": "photo_name"
                                    },
                                    "labelProps": {
                                        "text": "相册"
                                    },
                                    "style": {
                                        "textColor": "#f0f4fb",
                                        "fontSize": "${constant.gallery.font.name}"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "wrap",
                                        "height": "wrap",
                                        "flexGrow": 1
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "photo_info",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "bindings": {
                                        "labelProps.text": "photo_info"
                                    },
                                    "labelProps": {
                                        "text": ""
                                    },
                                    "style": {
                                        "textColor": "#8494a8",
                                        "fontSize": "${constant.gallery.font.meta}",
                                        "textAlign": "right"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "wrap",
                                        "height": "wrap"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "container",
                            "id": "buttons",
                            "commonProps": {
                                "clickable": false
                            },
                            "layout": {
                                "type": "flex",
                                "flexFlow": "row",
                                "mainAlign": "center",
                                "crossAlign": "center",
                                "gap": "${constant.gallery.layout.buttonGap}"
                            },
                            "style": {
                                "padding": "0dp"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "${constant.gallery.layout.buttonHeight}"
                            },
                            "children": [
                                {
                                    "type": "button",
                                    "id": "prev",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.prev"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#18223a",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "100dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "labelProps": {
                                                "text": "上一张"
                                            },
                                            "style": {
                                                "textColor": "#dbe4f2",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "button",
                                    "id": "next",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.next"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#18223a",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "100dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "labelProps": {
                                                "text": "下一张"
                                            },
                                            "style": {
                                                "textColor": "#dbe4f2",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "button",
                                    "id": "set_wallpaper",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.set_wallpaper"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#132a22",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "124dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "labelProps": {
                                                "text": "设为壁纸"
                                            },
                                            "style": {
                                                "textColor": "#c8e8d9",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "button",
                                    "id": "slideshow",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.slideshow"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#1b2540",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "116dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "bindings": {
                                                "labelProps.text": "slide_text"
                                            },
                                            "labelProps": {
                                                "text": "自动播放"
                                            },
                                            "style": {
                                                "textColor": "#dbe4f2",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "button",
                                    "id": "refresh",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.refresh"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#18223a",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "92dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "labelProps": {
                                                "text": "刷新"
                                            },
                                            "style": {
                                                "textColor": "#dbe4f2",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "button",
                                    "id": "back",
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "gallery.list"
                                        }
                                    ],
                                    "style": {
                                        "bgColor": "#18223a",
                                        "radius": "${constant.gallery.layout.buttonRadius}",
                                        "borderWidth": "0dp"
                                    },
                                    "layout": {
                                        "type": "flex",
                                        "mainAlign": "center",
                                        "crossAlign": "center"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "88dp",
                                        "height": "match"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "id": "text",
                                            "commonProps": {
                                                "clickable": false
                                            },
                                            "labelProps": {
                                                "text": "列表"
                                            },
                                            "style": {
                                                "textColor": "#dbe4f2",
                                                "fontSize": "${constant.gallery.font.button}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "label",
                            "id": "status",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "labelProps.text": "status_text"
                            },
                            "labelProps": {
                                "text": ""
                            },
                            "style": {
                                "textColor": "#6f8098",
                                "fontSize": "${constant.gallery.font.status}"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "wrap"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "container",
            "id": "drawer",
            "commonProps": {
                "clickable": false,
                "scrollable": false
            },
            "bindings": {
                "commonProps.hidden": "drawer_hidden"
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "mainAlign": "start",
                "crossAlign": "stretch",
                "gap": "${constant.gallery.layout.drawerGap}"
            },
            "style": {
                "bgColor": "#0b1220",
                "radius": "16dp",
                "borderWidth": "1dp",
                "borderColor": "#25324c",
                "padding": "${constant.gallery.layout.drawerPadding}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.gallery.layout.drawerX}",
                "y": "${constant.gallery.layout.drawerY}",
                "width": "${constant.gallery.layout.drawerWidth}",
                "height": "${constant.gallery.layout.drawerHeight}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "head",
                    "commonProps": {
                        "clickable": false
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "row",
                        "mainAlign": "spaceBetween",
                        "crossAlign": "center",
                        "gap": "8dp"
                    },
                    "style": {
                        "padding": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "${constant.gallery.layout.headHeight}"
                    },
                    "children": [
                        {
                            "type": "label",
                            "id": "list_info",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "labelProps.text": "list_info"
                            },
                            "labelProps": {
                                "text": "图片"
                            },
                            "style": {
                                "textColor": "#a9b8cd",
                                "fontSize": "${constant.gallery.font.rowMeta}"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "wrap",
                                "height": "wrap",
                                "flexGrow": 1
                            }
                        },
                        {
                            "type": "button",
                            "id": "close",
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "gallery.close"
                                }
                            ],
                            "style": {
                                "bgColor": "#18223a",
                                "radius": "10dp",
                                "borderWidth": "0dp"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "56dp",
                                "height": "26dp"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "text",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "labelProps": {
                                        "text": "关闭"
                                    },
                                    "style": {
                                        "textColor": "#dbe4f2",
                                        "fontSize": "${constant.gallery.font.rowMeta}"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "container",
                    "id": "list",
                    "commonProps": {
                        "clickable": false,
                        "scrollable": false
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "mainAlign": "start",
                        "crossAlign": "stretch",
                        "gap": "${constant.gallery.layout.listGap}"
                    },
                    "style": {
                        "padding": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "flexGrow": 1
                    },
                    "children": []
                },
                {
                    "type": "container",
                    "id": "pager",
                    "commonProps": {
                        "clickable": false
                    },
                    "bindings": {
                        "commonProps.hidden": "pager_hidden"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "row",
                        "mainAlign": "center",
                        "crossAlign": "center",
                        "gap": "8dp"
                    },
                    "style": {
                        "padding": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "${constant.gallery.layout.pagerHeight}"
                    },
                    "children": [
                        {
                            "type": "button",
                            "id": "prev",
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "gallery.page.prev"
                                }
                            ],
                            "style": {
                                "bgColor": "#18223a",
                                "radius": "10dp",
                                "borderWidth": "0dp"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.gallery.layout.pagerButtonWidth}",
                                "height": "match"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "text",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "labelProps": {
                                        "text": "上一页"
                                    },
                                    "style": {
                                        "textColor": "#dbe4f2",
                                        "fontSize": "${constant.gallery.font.rowMeta}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "label",
                            "id": "page",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "labelProps.text": "page_text"
                            },
                            "labelProps": {
                                "text": "1 / 1"
                            },
                            "style": {
                                "textColor": "#8494a8",
                                "fontSize": "${constant.gallery.font.rowMeta}",
                                "textAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.gallery.layout.pagerTextWidth}",
                                "height": "wrap"
                            }
                        },
                        {
                            "type": "button",
                            "id": "next",
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "gallery.page.next"
                                }
                            ],
                            "style": {
                                "bgColor": "#18223a",
                                "radius": "10dp",
                                "borderWidth": "0dp"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.gallery.layout.pagerButtonWidth}",
                                "height": "match"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "text",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "labelProps": {
                                        "text": "下一页"
                                    },
                                    "style": {
                                        "textColor": "#dbe4f2",
                                        "fontSize": "${constant.gallery.font.rowMeta}"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
