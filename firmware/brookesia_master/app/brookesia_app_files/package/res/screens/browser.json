{
    "type": "viewScreen",
    "id": "browser",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": false
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.files.layout.pagePadding}",
                "y": "${constant.files.layout.contentTop}",
                "width": "${expr(${env.widthDp} - ${constant.files.layout.pagePadding} * 2)}",
                "height": "${expr(${env.heightDp} - ${constant.files.layout.contentTop} - ${constant.files.layout.pagePadding})}"
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.files.layout.pageGap}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "list",
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "${constant.files.layout.cardPadding}"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "4dp"
                    },
                    "commonProps": {
                        "scrollable": true
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "1dp",
                        "flexGrow": 1
                    },
                    "children": [
                        {
                            "type": "container",
                            "id": "items",
                            "layout": {
                                "type": "flex",
                                "flexFlow": "column",
                                "gap": "4dp"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "wrap",
                                "alignSelf": "stretch"
                            }
                        }
                    ]
                },
                {
                    "type": "container",
                    "id": "picker_bar",
                    "commonProps": {
                        "hidden": true,
                        "scrollable": false
                    },
                    "bindings": {
                        "commonProps.hidden": "picker_hidden"
                    },
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "${constant.files.layout.cardPadding}"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "row",
                        "mainAlign": "spaceBetween",
                        "crossAlign": "center",
                        "gap": "${constant.files.layout.pickerGap}"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "${constant.files.layout.pickerHeight}",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "container",
                            "id": "mode",
                            "commonProps": {
                                "clickable": false
                            },
                            "styleRefs": [
                                "app.primaryChip"
                            ],
                            "style": {
                                "padding": "6dp"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "wrap",
                                "height": "wrap",
                                "alignSelf": "center"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "label",
                                    "bindings": {
                                        "labelProps.text": "picker_mode_text"
                                    },
                                    "labelProps": {
                                        "text": "${constant.files.i18n.paste_mode}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "label",
                            "id": "hint",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "labelProps.text": "picker_hint"
                            },
                            "styleRefs": [
                                "app.caption"
                            ],
                            "labelProps": {
                                "text": "${constant.files.i18n.pick_destination}"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "1dp",
                                "height": "wrap",
                                "flexGrow": 1
                            }
                        },
                        {
                            "type": "button",
                            "id": "cancel",
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "files.pick.cancel"
                                }
                            ],
                            "styleRefs": [
                                "app.secondaryChip"
                            ],
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.files.layout.pickerButtonWidth}",
                                "height": "${constant.files.layout.pickerButtonHeight}",
                                "alignSelf": "center"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "label",
                                    "labelProps": {
                                        "text": "${constant.files.i18n.cancel}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "button",
                            "id": "confirm",
                            "commonProps": {
                                "disabled": true
                            },
                            "bindings": {
                                "commonProps.disabled": "picker_confirm_disabled",
                                "style.opacity": "picker_confirm_opacity"
                            },
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "files.pick.confirm"
                                }
                            ],
                            "styleRefs": [
                                "app.primaryChip"
                            ],
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.files.layout.pickerButtonWidth}",
                                "height": "${constant.files.layout.pickerButtonHeight}",
                                "alignSelf": "center"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "label",
                                    "bindings": {
                                        "labelProps.text": "picker_confirm_text"
                                    },
                                    "labelProps": {
                                        "text": "${constant.files.i18n.paste_here}"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
