{
    "type": "viewScreen",
    "id": "bluetooth",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "templateRef",
                    "id": "status_card",
                    "templateId": "settings_card",
                    "overrides": {
                        ".": {
                            "style": {
                                "padding": "${constant.settings.layout.cardPadding}"
                            },
                            "layout": {
                                "gap": "12dp"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "wrap",
                                "alignSelf": "stretch"
                            }
                        }
                    },
                    "slots": {
                        "content": [
                            {
                                "type": "templateRef",
                                "id": "bluetooth_switch",
                                "templateId": "switch_row",
                                "overrides": {
                                    ".": {
                                        "placement": {
                                            "mode": "flow",
                                            "width": "match",
                                            "height": "${constant.settings.layout.rowHeight}",
                                            "alignSelf": "stretch"
                                        }
                                    },
                                    "text": {
                                        "layout": {
                                            "type": "flex",
                                            "flexFlow": "column",
                                            "mainAlign": "center",
                                            "crossAlign": "start",
                                            "gap": "2dp"
                                        }
                                    },
                                    "text/title": {
                                        "labelProps": {
                                            "text": "蓝牙"
                                        }
                                    },
                                    "text/subtitle": {
                                        "labelProps": {
                                            "text": "BLE 5（低功耗蓝牙，无经典蓝牙）"
                                        },
                                        "style": {
                                            "textColor": "${color.text.muted}"
                                        }
                                    },
                                    "toggle": {
                                        "commonProps": {
                                            "disabled": true
                                        },
                                        "toggleProps": {
                                            "checked": true
                                        }
                                    }
                                }
                            }
